# ── Required ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── API Server ────────────────────────────────────────
RAG_API_KEY=your-secret-api-key        # Leave empty for open access
RAG_API_PORT=8000
RAG_API_HOST=0.0.0.0
RAG_RATE_LIMIT_RPM=60
RAG_CORS_ORIGINS=*

# ── Models ────────────────────────────────────────────
RAG_LLM_MODEL=gpt-4.1-mini
RAG_LLM_MODEL_HQ=gpt-4.1
RAG_EMBEDDING_MODEL=text-embedding-3-large

# ── Retrieval ─────────────────────────────────────────
RAG_TOP_K=12
RAG_MAX_CONTEXT=14000

# ── Paths (optional overrides) ────────────────────────
# RAG_FED_DIR=/path/to/Federal_Contracting
# RAG_CHROMA_PATH=/path/to/chroma_db

# ── Company Info ──────────────────────────────────────
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=123 Main St, Suite 100
COMPANY_CITY_STATE=City, State ZIP
COMPANY_PHONE=000-000-0000
COMPANY_EMAIL=contact@company.com
COMPANY_WEBSITE=www.company.com

# ── SAM.gov Pipeline ──────────────────────────────────
SAM_API_KEY=
TARGET_NAICS=541512,541513

# ── Logging ───────────────────────────────────────────
RAG_LOG_LEVEL=INFO
# RAG_LOG_FILE=rag_project.log
